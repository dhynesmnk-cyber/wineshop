# Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================
# SANITY CMS CONFIGURATION
# ============================================
# Get these from https://sanity.io/manage
SANITY_PROJECT_ID=your_project_id_here
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
SANITY_USE_CDN=true
# Required for write operations (creating/updating content)
SANITY_API_TOKEN=sanity_api_token_with_edit_permissions
# Optional: For preview mode with draft content
SANITY_PREVIEW_TOKEN=sanity_preview_token

# ============================================
# STRIPE PAYMENT CONFIGURATION
# ============================================
# Get these from https://dashboard.stripe.com/apikeys
# Test keys (use for development)
STRIPE_PUBLIC_KEY=pk_test_your_test_public_key
STRIPE_SECRET_KEY=sk_test_your_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret
# Production keys (use for live site)
# STRIPE_PUBLIC_KEY=pk_live_your_live_public_key
# STRIPE_SECRET_KEY=sk_live_your_live_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret

# ============================================
# NETLIFY CONFIGURATION
# ============================================
# Netlify will auto-detect most of these, but you can override if needed
NETLIFY_SITE_ID=your_netlify_site_id
# This is automatically set by Netlify during build
# NETLIFY=true

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Base URL for your site (no trailing slash)
SITE_URL=https://winedrop.example.com
# Site name for branding
SITE_NAME="Wine Drop"
# Default currency
DEFAULT_CURRENCY=USD
# Age verification requirement (21 for US)
MIN_AGE=21

# ============================================
# GEOLOCATION CONFIGURATION
# ============================================
# Optional: Fallback geolocation API key (if Netlify geo is unavailable)
# IPAPI, IPSTACK, or similar service
IPGEO_API_KEY=your_ip_geolocation_api_key

# ============================================
# EMAIL NOTIFICATION CONFIGURATION
# ============================================
# For sending order notifications to suppliers
# Using Netlify Send, SendGrid, Resend, etc.
EMAIL_FROM=noreply@winedrop.example.com
# Example for Resend
RESEND_API_KEY=re_your_resend_api_key
# Example for SendGrid
# SENDGRID_API_KEY=SG.your_sendgrid_api_key

# ============================================
# ANALYTICS & MONITORING (Optional)
# ============================================
# Google Analytics 4
GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Plausible Analytics (privacy-friendly alternative)
# PLAUSIBLE_DOMAIN=winedrop.example.com
# Sentry for error tracking
# SENTRY_DSN=https://your_sentry_dsn

# ============================================
# SECURITY (Optional but recommended)
# ============================================
# Cookie secret for session encryption
COOKIE_SECRET=your_secure_random_cookie_secret_at_least_32_chars
# CSRF token secret
# CSRF_SECRET=your_csrf_secret

# ============================================
# RATE LIMITING (Optional)
# ============================================
# For API rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# FEATURE FLAGS (Optional)
# ============================================
# Enable/disable features without code changes
ENABLE_BLOG=true
ENABLE_REVIEWS=false
ENABLE_WISHLIST=false
