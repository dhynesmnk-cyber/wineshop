---
import { sanityFetch } from '../../lib/sanity';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getImageUrl } from '../../lib/sanity';

interface BlogPost {
  _id: string;
  title: string;
  slug?: { current: string };
  excerpt?: string;
  content?: any[];
  mainImage?: { asset?: { _ref: string; alt?: string } };
  author?: { name: string; image?: { asset?: { _ref: string } } };
  publishedAt?: string;
  categories?: Array<{ title: string; slug?: { current: string } }>;
  faq?: Array<{ question: string; answer: string }>;
}

interface Props {
  post: BlogPost;
  relatedPosts: BlogPost[];
}

export async function getStaticPaths() {
  try {
    const posts = await sanityFetch(`*[_type == "blogPost" && defined(slug.current)]{ _id, title, "slug": slug.current }`);
    
    if (!posts || posts.length === 0) {
      return [];
    }

    const paths = [];
    for (const post of posts) {
      try {
        const fullPost = await sanityFetch(
          `*[_type == "blogPost" && slug.current == "${post.slug}"][0] {
            _id, title, slug, excerpt, content, 
            "mainImage": mainImage { asset->{_ref, alt}, alt, caption },
            "author": author->{ name, "image": image { asset->{_ref} } },
            publishedAt,
            "categories": categories[]->{ title, "slug": slug.current },
            faq { question, answer }
          }`
        );
        
        let relatedPosts: BlogPost[] = [];
        if (fullPost && fullPost.categories && fullPost.categories.length > 0) {
          const categorySlugs = fullPost.categories.map((c: any) => c.slug).filter(Boolean);
          if (categorySlugs.length > 0) {
            relatedPosts = await sanityFetch(
              `*[_type == "blogPost" && slug.current != "${post.slug}" && categories[]->slug.current in [${categorySlugs.map(s => `"${s}"`).join(', ')}]] | order(publishedAt desc) [0...3] {
                _id, title, "slug": slug.current, excerpt,
                "mainImage": mainImage { asset->{_ref, alt}, alt }
              }`
            ) || [];
          }
        }
        
        paths.push({
          params: { slug: post.slug },
          props: { post: fullPost, relatedPosts },
        });
      } catch (error) {
        console.error(`Error fetching post ${post.slug}:`, error);
      }
    }

    return paths;
  } catch (error) {
    console.error('Error generating blog paths:', error);
    return [];
  }
}

const { post, relatedPosts } = Astro.props;

if (!post) {
  return Astro.redirect('/blog');
}

const canonicalUrl = `https://wine-drop.example.com/blog/${post.slug?.current || post.slug}`;
const imageUrl = post.mainImage?.asset ? getImageUrl(post.mainImage.asset._ref, 1200, 630) : '';
const publishDate = post.publishedAt ? new Date(post.publishedAt).toISOString().split('T')[0] : '';
---

<BaseLayout
  title={`${post.title} | Wine Drop`}
  description={post.excerpt || ''}
  canonicalURL={canonicalUrl}
  ogImage={imageUrl}
  twitterCard="summary_large_image"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.title,
    "description": post.excerpt,
    "image": imageUrl,
    "datePublished": post.publishedAt,
    "author": post.author ? {
      "@type": "Person",
      "name": post.author.name,
      "image": post.author.image?.asset ? getImageUrl(post.author.image.asset._ref, 100, 100) : undefined
    } : undefined,
    "publisher": {
      "@type": "Organization",
      "name": "Wine Drop",
      "logo": {
        "@type": "ImageObject",
        "url": "https://wine-drop.example.com/logo.png"
      }
    }
  })} />

  <article class="max-w-4xl mx-auto px-4 py-12">
    <header class="mb-10">
      <a href="/blog" class="text-burgundy-600 hover:text-burgundy-700 font-medium mb-4 inline-block">&larr; Back to Blog</a>
      
      <h1 class="text-4xl md:text-5xl font-serif font-bold text-burgundy-900 mb-4">{post.title}</h1>
      
      <div class="flex items-center gap-4 text-gray-600 mb-6">
        {post.author && (
          <div class="flex items-center gap-3">
            {post.author.image?.asset && (
              <img 
                src={getImageUrl(post.author.image.asset._ref, 100, 100)}
                alt={post.author.name}
                class="w-12 h-12 rounded-full object-cover"
                width="48"
                height="48"
              />
            )}
            <span class="font-medium">{post.author.name}</span>
          </div>
        )}
        {publishDate && (
          <time datetime={publishDate} class="text-gray-500">
            {new Date(post.publishedAt!).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        )}
      </div>

      {post.categories && post.categories.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {post.categories.map((category: any) => (
            <span class="px-3 py-1 bg-cream-200 text-burgundy-700 rounded-full text-sm font-medium">
              {category.title}
            </span>
          ))}
        </div>
      )}
    </header>

    {post.mainImage?.asset && (
      <figure class="mb-10">
        <img
          src={getImageUrl(post.mainImage.asset._ref, 1200, 630)}
          alt={post.mainImage.alt || post.mainImage.caption || post.title}
          class="w-full h-auto rounded-lg shadow-lg"
          width="1200"
          height="630"
          loading="eager"
        />
        {post.mainImage.caption && (
          <figcaption class="text-center text-gray-600 mt-3 italic">{post.mainImage.caption}</figcaption>
        )}
      </figure>
    )}

    <div class="prose prose-lg prose-burgundy max-w-none mb-12">
      {post.content && post.content.length > 0 ? (
        post.content.map((block: any) => (
          block._type === 'block' ? (
            block.style === 'h2' ? <h2>{(block.children || []).map((c: any) => c.text).join('')}</h2> :
            block.style === 'h3' ? <h3>{(block.children || []).map((c: any) => c.text).join('')}</h3> :
            block.style === 'blockquote' ? <blockquote>{(block.children || []).map((c: any) => c.text).join('')}</blockquote> :
            <p>{(block.children || []).map((c: any) => c.text).join('')}</p>
          ) : block._type === 'image' && block.asset ? (
            <img 
              src={getImageUrl(block.asset._ref, 800, 600)} 
              alt={block.alt || ''}
              class="w-full rounded-lg my-6"
            />
          ) : null
        ))
      ) : (
        <p class="text-xl text-gray-600">{post.excerpt}</p>
      )}
    </div>

    {post.faq && post.faq.length > 0 && (
      <section class="mb-12" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="text-2xl font-serif font-bold text-burgundy-900 mb-6">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {post.faq.map((item: any, index: number) => (
            <details class="group bg-cream-50 rounded-lg p-4 cursor-pointer" key={index}>
              <summary class="font-semibold text-burgundy-800 list-none flex justify-between items-center">
                {item.question}
                <span class="ml-4 text-burgundy-600 group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="mt-3 text-gray-700">{item.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": post.faq?.map((item: any) => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answer
        }
      })) || []
    })} />
  </article>

  {relatedPosts && relatedPosts.length > 0 && (
    <section class="bg-cream-100 py-12">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-3xl font-serif font-bold text-burgundy-900 mb-8">Related Articles</h2>
        <div class="grid md:grid-cols-3 gap-6">
          {relatedPosts.map((related: BlogPost) => (
            <a 
              href={`/blog/${related.slug?.current || related.slug}`}
              class="group bg-white rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-shadow"
            >
              {related.mainImage?.asset && (
                <img
                  src={getImageUrl(related.mainImage.asset._ref, 400, 250)}
                  alt={related.mainImage.alt || related.title}
                  class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300"
                  width="400"
                  height="250"
                  loading="lazy"
                />
              )}
              <div class="p-4">
                <h3 class="font-serif font-bold text-lg text-burgundy-900 group-hover:text-gold-600 transition-colors line-clamp-2">
                  {related.title}
                </h3>
                {related.excerpt && (
                  <p class="text-gray-600 mt-2 text-sm line-clamp-2">{related.excerpt}</p>
                )}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
