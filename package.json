{
  "name": "wine-drop",
  "type": "module",
  "version": "1.0.0",
  "description": "Hyper-local wine dropshipping e-commerce platform",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:preview": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint src --ext .ts,.tsx,.astro",
    "lint:fix": "eslint src --ext .ts,.tsx,.astro --fix",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "sanity:extract-schema": "npx sanity schema extract --enforce-required-fields --workspace=default",
    "sanity:generate-types": "npx sanity-gen types"
  },
  "dependencies": {
    "@astrojs/netlify": "^5.2.0",
    "@astrojs/react": "^3.3.0",
    "@astrojs/tailwind": "^5.1.0",
    "@netlify/edge-functions": "^2.5.0",
    "@sanity/client": "^6.15.0",
    "@sanity/image-url": "^1.0.2",
    "@stripe/stripe-js": "^3.3.0",
    "astro": "^4.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "stripe": "^14.21.0",
    "tailwindcss": "^3.4.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.0",
    "eslint-plugin-astro": "^0.31.4",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "prettier-plugin-astro": "^0.13.0",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "wine",
    "e-commerce",
    "dropshipping",
    "astro",
    "netlify",
    "sanity"
  ],
  "author": "Wine Drop Team",
  "license": "MIT"
}
